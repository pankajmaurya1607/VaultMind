# VaultMind — Minimal RAG+RBAC Deploy (root .env for docker compose)
# 2-command deploy:
#   cp .env.example .env   # then set SECRET_KEY + LLM keys
#   docker compose up -d --build
# UI: http://localhost       API: http://localhost/api/v1
# Health: http://localhost/health  or http://localhost:8000/health

# --- Required ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-at-least-32-random-chars
ENVIRONMENT=development
# Set to production to enforce SECRET_KEY check (app/config/settings.py:78)

# --- LLM — one key recommended; empty = local fallback (RAG search works, chat uses template) ---
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.1-70b-versatile

# --- Production overrides (uncomment & set) ---
# POSTGRES_USER=eka_user
# POSTGRES_PASSWORD=strong-random-password  # also update DATABASE_URL below + docker-compose.yml
# POSTGRES_DB=eka_db
# DATABASE_URL=postgresql+asyncpg://eka_user:strong-pass@postgres:5432/eka_db
# DATABASE_URL_SYNC=postgresql+psycopg2://eka_user:strong-pass@postgres:5432/eka_db
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0
# CELERY_WORKER_POOL=prefork  # prefork=Linux/Docker (prod), solo=Windows local (fixes billiard Access denied)
# CELERY_WORKER_CONCURRENCY=4
# CORS_ORIGINS=["https://yourdomain.com"]  # default localhost:3000/5173/5174
# TRUST_PROXY_HEADERS=true  # set true behind reverse proxy / load balancer
