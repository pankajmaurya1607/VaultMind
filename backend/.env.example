# Backend local dev — for `uvicorn`/`celery` without docker (docker uses root /.env)
# Copy to backend/.env then edit SECRET_KEY + LLM keys; root /.env is used by compose

# App (must be >=32 chars when ENVIRONMENT=production, see app/config/settings.py:78)
APP_NAME=VaultMind
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=change-me-to-at-least-32-random-chars
ENVIRONMENT=development

# Database — localhost for manual run; compose overrides to postgres:5432 via environment + root /.env
DATABASE_URL=postgresql+asyncpg://eka_user:eka_pass@localhost:5432/eka_db
DATABASE_URL_SYNC=postgresql+psycopg2://eka_user:eka_pass@localhost:5432/eka_db

# Redis — localhost for manual run; compose overrides to redis:6379
REDIS_URL=redis://localhost:6379/0

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# LLM — empty = fallback template (RAG search still works)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Embedding / Vector — must match PGVector migration 384-dim bge-small-en-v1.5
EMBEDDING_MODEL_LOCAL=BAAI/bge-small-en-v1.5
PGVECTOR_DIMENSION=384

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=[".pdf",".docx",".md",".csv",".xlsx",".txt"]

# Chunking / Retrieval
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
SIMILARITY_THRESHOLD=0.7

# Celery - pool: prefork=Linux/Docker prod, solo=Windows local (fixes PermissionError WinError 5/6)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_WORKER_POOL=solo
CELERY_WORKER_CONCURRENCY=2

# Monitoring / Rate Limit / CORS — defaults for dev
PROMETHEUS_PORT=9090
RATE_LIMIT_PER_MINUTE=60
TRUST_PROXY_HEADERS=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5174"]
