# App
APP_NAME=Enterprise Knowledge Assistant
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=your-secret-key-change-in-production
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://eka_user:eka_pass@localhost:5432/eka_db
DATABASE_URL_SYNC=postgresql+psycopg2://eka_user:eka_pass@localhost:5432/eka_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Groq (fallback)
GROQ_API_KEY=gsk-your-groq-api-key
GROQ_MODEL=llama-3.1-70b-versatile

# Sentence Transformers (local fallback)
EMBEDDING_MODEL_LOCAL=BAAI/bge-small-en-v1.5

# PGVector
PGVECTOR_DIMENSION=1536

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=.pdf,.docx,.md,.csv,.xlsx,.txt

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval
TOP_K=5
SIMILARITY_THRESHOLD=0.7

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Monitoring
PROMETHEUS_PORT=9090
OPENTELEMETRY_ENABLED=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
