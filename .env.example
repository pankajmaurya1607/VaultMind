# VaultMind / EKA — Docker Compose environment
# Copy to .env at repo root before running docker compose

# Security — REQUIRED in production (fail-fast otherwise)
SECRET_KEY=generate-a-long-random-string-here
ENVIRONMENT=development

# LLM providers (at least one recommended; local fallback works without keys)
GEMINI_API_KEY=
GROQ_API_KEY=

# Grafana admin password
GRAFANA_ADMIN_PASSWORD=admin
