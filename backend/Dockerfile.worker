FROM python:3.12-slim

WORKDIR /app

# No compiled deps left (torch/pandas/grpc removed) - only libpq + onnxruntime runtime lib.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --upgrade pip && pip install --no-cache-dir --prefer-binary -r requirements.txt

COPY . .

ENV PYTHONPATH=/app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN groupadd -r eka && useradd -r -g eka eka \
    && mkdir -p /app/uploads \
    && chown -R eka:eka /app
USER eka

HEALTHCHECK --interval=60s --timeout=10s --start-period=60s --retries=3 \
  CMD celery -A app.workers.celery_app inspect ping -d celery@$$HOSTNAME --timeout 5 || exit 1

# Uses CELERY_WORKER_POOL/CONCURRENCY from env (prefork on Linux prod, solo on Windows local)
CMD ["sh", "-c", "celery -A app.workers.celery_app worker --loglevel=info --pool=${CELERY_WORKER_POOL:-prefork} --concurrency=${CELERY_WORKER_CONCURRENCY:-4} -Q document_processing,celery"]
