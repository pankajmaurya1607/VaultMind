FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --upgrade pip && pip install --no-cache-dir --prefer-binary -r requirements.txt

COPY . .

ENV PYTHONPATH=/app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN groupadd -r eka && useradd -r -g eka eka \
    && mkdir -p /app/uploads \
    && chown -R eka:eka /app
USER eka

HEALTHCHECK --interval=60s --timeout=10s --start-period=60s --retries=3 \
  CMD celery -A app.workers.celery_app inspect ping -d celery@$$HOSTNAME --timeout 5 || exit 1

CMD ["celery", "-A", "app.workers.celery_app", "worker", "--loglevel=info", "--concurrency=4", "-Q", "document_processing,celery"]
