groups:
- name: vaultmind-alerts
  interval: 60s
  rules:
  - alert: HighErrorRate
    expr: rate(error_count[5m]) > 0.5
    for: 5m
    labels:
      severity: critical
    annotations:
      summary: "High error rate detected"
      description: "Error rate is {{ $value }} errors/sec over 5 minutes"

  - alert: ChatLatencyHigh
    expr: histogram_quantile(0.95, sum(chat_response_duration_ms_bucket) by (le) OR on le (le=\"10000\")) > 3000
    for: 2m
    labels:
      severity: warning
    annotations:
      summary: "Chat latency is high"
      description: "95th percentile chat response latency is {{ $value }}ms over 2 minutes"

  - alert: SearchLatencyHigh
    expr: histogram_quantile(0.95, sum(search_duration_ms_bucket) by (le) OR on le (le=\"1000\")) > 500
    for: 2m
    labels:
      severity: warning
    annotations:
      summary: "Search latency is high"
      description: "95th percentile search latency is {{ $value }}ms over 2 minutes"

  - alert: ManyFailedDocuments
    expr: sum(increase(documents_total{status=\"failed\"}[1h])) > 5
    for: 5m
    labels:
      severity: warning
    annotations:
      summary: "Many document processing failures"
      description: "More than 5 documents have failed processing in the last hour"

  - alert: LowDocumentProcessingRate
    expr: sum(rate(documents_total{status=\"ready\"}[5m])) < 0.1
    for: 10m
    labels:
      severity: info
    annotations:
      summary: "Low document processing rate"
      description: "Fewer than 0.1 documents per minute are being successfully processed"