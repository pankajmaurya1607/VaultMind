groups:
- name: vaultmind-alerts
  interval: 60s
  rules:
  - alert: HighErrorRate
    expr: |
      sum(rate(http_requests_total{status=~"5.."}[5m]))
        / clamp_min(sum(rate(http_requests_total[5m])), 0.001) > 0.05
    for: 5m
    labels:
      severity: critical
    annotations:
      summary: "High error rate detected"
      description: "5xx responses exceed 5% of traffic ({{ $value | humanizePercentage }} over 5 minutes)"

  - alert: ChatLatencyHigh
    expr: histogram_quantile(0.95, sum(rate(chat_response_duration_ms_bucket[5m])) by (le)) > 3000
    for: 2m
    labels:
      severity: warning
    annotations:
      summary: "Chat latency is high"
      description: "95th percentile chat response latency is {{ $value }}ms over 2 minutes"

  - alert: SearchLatencyHigh
    expr: histogram_quantile(0.95, sum(rate(search_duration_ms_bucket[5m])) by (le)) > 500
    for: 2m
    labels:
      severity: warning
    annotations:
      summary: "Search latency is high"
      description: "95th percentile search latency is {{ $value }}ms over 2 minutes"

  - alert: ManyFailedDocuments
    expr: sum(documents_total{status="failed"}) > 10
    for: 15m
    labels:
      severity: warning
    annotations:
      summary: "Many documents failed processing"
      description: "{{ $value }} documents are in failed state"

  - alert: DocumentUploadsStalled
    expr: sum(rate(http_requests_total{endpoint="/api/v1/documents", method="POST"}[15m])) < 0.01
    for: 15m
    labels:
      severity: info
    annotations:
      summary: "No document uploads in a while"
      description: "Fewer than 0.6 uploads/hour observed over the last 15 minutes"
